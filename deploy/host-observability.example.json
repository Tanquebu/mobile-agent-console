  "expected_tcp_listeners": [
    {
      "port": 4242,
      "scopes": ["loopback", "tailscale"]
    }
  ],
  "process_labels": {
    "example-worker": "Example worker",
    "example-service": "Example service"
  },
  "docker": {
    "enabled": true,
    "container_labels": {
      "example-backend": "Backend",
      "example-web": "Web"
    }
  }
