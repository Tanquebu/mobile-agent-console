    "memory_available_critical_percent": 10,
    "swap_used_warning_percent": 50,
    "swap_used_critical_percent": 80,
    "load_per_cpu_warning": 1,
    "load_per_cpu_critical": 2,
    "process_group_warning_count": 5,
    "process_group_critical_count": 10
  },
  "filesystems": [
    {
      "label": "Example system disk",
      "path": "/srv/example-system",
