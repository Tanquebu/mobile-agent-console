[Unit]
Description=Collect Mobile Agent Console host disk free space

[Service]
Type=oneshot
EnvironmentFile=%h/.config/mobile-agent-console/environment
ExecStart=/usr/bin/python3 ${MAC_INSTALL_DIR}/deploy/disk-space-collector.py --output ${MAC_WORKSPACE_ROOT}/.mobile-agent-console/disk-space.json
# Solo statvfs sui path configurati e un file 0600 in output: nessun socket,
# quindi l'hardening con mount namespace non incontra il limite AppArmor
# descritto in ADR 011.
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TimeoutStartSec=30
