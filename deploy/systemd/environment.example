# Copiare in ~/.config/mobile-agent-console/environment.
# Il path deve contenere compose.yaml e il file .env del deployment.
MAC_INSTALL_DIR=/home/example/.local/share/mobile-agent-console
# Root persistente condivisa con il backend.
MAC_WORKSPACE_ROOT=/home/example/projects
# Overlay compose opzionali, come coppie "-f PATH" separate da spazio. Le unit
# passano i file base esplicitamente e docker compose NON legge COMPOSE_FILE
# dal file indicato con --env-file: senza questa variabile un riavvio dell'host
# ricrea i container privi degli overlay, spegnendo le feature opzionali
# (INC-HOST-01). I path sono assoluti perche' le unit non hanno WorkingDirectory.
MAC_COMPOSE_OVERLAYS=-f /home/example/.local/share/mobile-agent-console/compose.host-observability.yaml
# Opzionale, solo con compose.host-observability.yaml. Il path è la directory
# della user socket unit, mai il file socket.
MAC_HOST_OBSERVABILITY_SOCKET_DIR=/run/user/UID_DA_SOSTITUIRE/mobile-agent-console
# Copiare l'esempio fuori dal repository, sostituire soltanto con valori reali
# host-side e mantenere il file 0600.
MAC_HOST_OBSERVABILITY_CONFIG_FILE=/home/example/.config/mobile-agent-console/host-observability.json
# Solo Docker rootless/userns-remap: UID host a cui è mappato l'UID 10001 del
# backend. Ricavarlo con il probe documentato nel gate, non indovinarlo.
MAC_HOST_OBSERVABILITY_ROOTLESS_UID=
# Opzionale, solo per mobile-agent-console-service-state: path assoluto del
# binario pm2, che è locale all'utente. Lasciare vuoto se pm2 non è installato:
# in quel caso pm2 non è un supervisore muto, semplicemente non esiste.
MAC_PM2_BINARY=
# Nome MagicDNS del nodo Tailscale (tailscale status --self), usato da
# mobile-agent-console-tls-renew per rinnovare il certificato nginx.
MAC_TAILNET_HOSTNAME=example-host.example-tailnet.ts.net
# Optional external orchestrator state collector. These values remain only in
# this private environment file; use an HTTPS URL unless the endpoint is local.
MAC_ORCHESTRATOR_STATE_URL=https://orchestrator.example.invalid/state
MAC_ORCHESTRATOR_STATE_TOKEN=replace-with-a-secret
# Optional; use the header expected by the external endpoint.
MAC_ORCHESTRATOR_STATE_TOKEN_HEADER=Authorization
