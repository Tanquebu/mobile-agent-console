{
  "name": "mobile-agent-console-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:host": "node --test tests/host-observability-ui.test.mjs",
    "test:budget": "node --test tests/budget-view.test.mjs",
    "test:console": "node --test tests/session-console-ui.test.mjs",
    "test:admin": "node --test tests/admin-optional-features.test.mjs",
    "test:timeline": "node --test tests/session-timeline-ui.test.mjs",
    "test:opencode": "node --test tests/opencode-blocks-ui.test.mjs",
    "test:session-guard": "node --test tests/session-termination-guard.test.mjs",
    "test:directory": "node --test tests/directory-project-ui.test.mjs",
    "test:directory:browser": "node tests/directory-preview-browser.mjs",
    "test:ui": "npm run test:host && npm run test:budget && npm run test:console && npm run test:admin && npm run test:timeline && npm run test:opencode && npm run test:session-guard && npm run test:directory",
    "test:host:browser": "node tests/host-observability-browser.mjs",
    "test:console:browser": "node tests/session-console-browser.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "1.61.1"
  }
}
