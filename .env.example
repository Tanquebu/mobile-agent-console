# Set this to the machine's Tailscale IPv4 (tailscale ip -4) for direct access.
# Keep 127.0.0.1 when using `tailscale serve` as a reverse proxy.
MAC_BIND_IP=127.0.0.1
# Host port for the published web UI.
MAC_BIND_PORT=8081
MAC_HOST=0.0.0.0
MAC_PORT=8080
MAC_LOGIN_PASSWORD_FILE=/run/secrets/mac_login_password
MAC_SESSION_SECRET_FILE=/run/secrets/mac_session_secret
MAC_TMUX_SOCKET=mobile-agent-console
# Nginx terminates TLS with a certificate issued for your tailnet's MagicDNS
# name (see docs/adr/008-tailscale-cert-tls.md): a secure browser context is
# required for the Notification/ServiceWorker APIs, not just best practice.
#   sudo tailscale set --operator=$USER   # one-time
#   mkdir -p .secrets/tls
#   tailscale cert --cert-file .secrets/tls/tailscale.crt \
#     --key-file .secrets/tls/tailscale.key <your-magicdns-name>
# Override the paths below only if you keep the cert/key elsewhere.
#MAC_TLS_CERT_FILE=./.secrets/tls/tailscale.crt
#MAC_TLS_KEY_FILE=./.secrets/tls/tailscale.key
# Update to your real https://<magicdns-name>:<MAC_BIND_PORT> once TLS is set up.
MAC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8081
# Set to true once served over HTTPS: Secure cookies are dropped by browsers
# over plain HTTP, so flipping this before TLS is live breaks login.
MAC_COOKIE_SECURE=false
MAC_TMUX_SOCKET_PATH=/tmux
# Directory tree that sessions are allowed to start in. In docker mode it is
# mounted at /workspace inside the runtime; defaults to ./workspace.
#MAC_WORKSPACE_ROOT=/home/youruser/projects
# Optional directory suggestions shown as a dropdown in the "new session"
# form. Format: label=path,label=path (or a JSON object). Keep your real
# paths in .env only — never commit them.
#MAC_WORKSPACE_PRESETS=myproject=/home/youruser/projects/myproject,tools=/home/youruser/projects/tools
# Maximum size of a single prompt attachment (default: 10 MiB). Attachments
# are stored below .agent-attachments in the configured workspace.
#MAC_MAX_ATTACHMENT_BYTES=10485760
# Total attachment storage allowed per session (default: 100 MiB), on top of
# the per-file limit above.
#MAC_MAX_ATTACHMENT_BYTES_PER_SESSION=104857600
# Automatically remove temporary attachment files after this many seconds
# (default: 24 hours, minimum: 5 minutes).
#MAC_ATTACHMENT_TTL_SECONDS=86400
# Seconds after an output change during which an agent is considered active.
#MAC_AGENT_ACTIVE_WINDOW_SECONDS=8
# Web Push: VAPID private key file, auto-generated on first startup if
# missing (kept in the persistent workspace, like the database).
#MAC_PUSH_VAPID_KEY_PATH=/workspace/.mobile-agent-console/vapid_private_key.pem
# Contact address included in the VAPID claims (not publicly exposed).
#MAC_PUSH_CONTACT_EMAIL=admin@localhost
# How often the backend checks agent status for push notifications.
#MAC_PUSH_POLL_INTERVAL_SECONDS=5
# Espone la cronologia Claude normalizzata dal collector host opzionale.
# Richiede host-tmux e il relativo timer; default false per rollback sicuro.
#MAC_CLAUDE_HISTORY_ENABLED=false
# SQLite database path. Defaults to a private directory under the workspace.
#MAC_DATABASE_PATH=/home/youruser/projects/.mobile-agent-console/app.db
# Number of local backups retained automatically (default: 10).
#MAC_BACKUP_RETENTION=10
# Username created only when the users table is empty.
#MAC_BOOTSTRAP_USERNAME=admin
# Failed/successful login attempts allowed per window (defaults: 5 / 60 s).
#MAC_LOGIN_RATE_LIMIT=5
#MAC_LOGIN_RATE_WINDOW_SECONDS=60
# Authenticated POST/DELETE requests allowed per window (defaults: 120 / 60 s).
#MAC_MUTATION_RATE_LIMIT=120
#MAC_MUTATION_RATE_WINDOW_SECONDS=60

# --- Host-tmux mode (ADR 005) ---
# Connects the backend to the host user's default tmux socket: sessions get
# the host's CLIs/aliases and the console sees pre-existing tmux sessions.
# Prerequisite: a running host tmux server (see README). To enable, uncomment
# ALL of the following lines (the override requires them explicitly):
#COMPOSE_FILE=compose.yaml:compose.host.yaml
# UID/GID the backend runs as to access the socket. Rootful Docker: your
# real uid/gid (id -u / id -g). ROOTLESS Docker: use 0/0 — container uid 0
# maps to the user owning the daemon (and the socket), while a non-zero uid
# would map to a subuid with no access.
#MAC_UID=1000
#MAC_GID=1000
# Default socket directory: /tmp/tmux-<uid>.
#MAC_TMUX_SOCKET_DIR=/tmp/tmux-1000
#MAC_TMUX_SOCKET_FILE=/tmp/tmux-1000/default
# Projects root, mounted same-path into the backend in host mode.
#MAC_WORKSPACE_ROOT=/home/youruser/projects
